# Copy this file to .env and fill in the values. .env is git-ignored.
#
# IMPORTANT: do NOT add ANTHROPIC_API_KEY here (or anywhere).
# Ultron runs on the Claude Pro login used by Claude Code. If an API key
# is present, Claude Code bills that key instead of using the Pro subscription.

# Free image search API key (Phase 4c) — https://www.pexels.com/api/
PEXELS_API_KEY=

# More stock video for Reels (optional, free): https://pixabay.com/api/docs/ (log in to see your key).
# Empty = Pexels only.
PIXABAY_API_KEY=

# Ultron's own Instagram (tools/instagram.py): a Creator account and a Meta app using
# "API setup with Instagram Login" with instagram_business_content_publish. Generate the
# token in the app's dashboard. Ultron renews it weekly into storage/instagram_token.json.
INSTAGRAM_ACCESS_TOKEN=

# Spotify playlists (optional). Playing music needs nothing; reading your playlists'
# songs needs your own Spotify developer app (the app owner needs Spotify Premium):
#   1. https://developer.spotify.com/dashboard -> Create app, tick "Web API"
#   2. Redirect URI: http://127.0.0.1:8000/spotify/callback  (use your JARVIS_PORT)
#   3. Paste the app's Client ID here. No client secret needed.
# The first time, Ultron shows a login link on the canvas.
SPOTIFY_CLIENT_ID=

# Ultron texting your phone (optional), from its own Telegram bot:
#   1. In Telegram, message @BotFather: /newbot, pick a name. Paste the token it gives here.
#   2. Open your new bot's chat and press Start (a bot can't text you first).
#   3. cd backend && .venv/bin/python -m tools.telegram   -> prints your TELEGRAM_CHAT_ID
# The token is a password for the bot: keep it in .env only.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Your phone's volume (optional), through MacroDroid (free, Android). On the phone:
#   1. Install MacroDroid. Variables (bottom bar) -> add a global integer: volume_level
#   2. Add Macro. Trigger: Connectivity -> Webhook (URL), identifier: jarvis_volume.
#      It shows a URL like https://trigger.macrodroid.com/<device-id>/jarvis_volume
#   3. Action: Volume -> Volume Change -> Media, set to the variable volume_level. Save.
#   4. Paste that URL here. It's private to your phone: keep it in .env only.
# Taxis and Careem Food (optional), the same way: Careem opens with the destination
# (or restaurant) copied.
#   1. Variables -> add a global string: taxi_to
#   2. Add Macro. Trigger: Connectivity -> Webhook (URL), identifier: jarvis_careem.
#   3. Actions: Device Actions -> Fill Clipboard, text: [v=taxi_to]
#               Applications -> Launch Application -> Careem. Save.
# In MacroDroid's settings, let it run in the background (no battery optimisation).
MACRODROID_WEBHOOK=

# School homework from Microsoft Teams (optional). Ultron reads the Teams activity feed
# from Google Chrome on this Mac, where you're signed in to your school account:
#   1. Chrome menu bar: View -> Developer -> Allow JavaScript from Apple Events
#   2. Open https://teams.cloud.microsoft in Chrome and sign in once
# Only set this if your school's Teams has a different address.
JARVIS_HOMEWORK_URL=

# Amazon (optional). Ultron browses Amazon in Google Chrome on this Mac, where you're signed
# in: search, orders, cart and wish lists. It can add to the cart or a list when you ask,
# and never places an order. Needs the same Chrome setting as homework (step 1 above).
# Set this if you shop on another Amazon site than amazon.ae, e.g. https://www.amazon.de
JARVIS_AMAZON_URL=

# Your Obsidian vault (optional): the folder you opened in Obsidian. Ultron searches and
# reads its notes, and saves notes there (it asks first for notes you marked important). Notes tagged #private are
# never read. Empty = no notes.
JARVIS_VAULT=

# The one folder Ultron may find, open, move, rename and trash files in (optional). Its
# sandboxed Python reads only this folder and writes only to its Output subfolder.
# Empty = ~/Jarvis Files.
JARVIS_FILES_DIR=

# Blender, for final 3D files (Phase 4d). This is the default location.
BLENDER_PATH=/Applications/Blender.app/Contents/MacOS/Blender

# Folder of ready-made 3D models (.glb) Ultron shows before building its own. Empty = backend/library3d.
JARVIS_3D_LIBRARY=

# 3DAssets.dev, a free online library of CC0 .glb models Ultron searches next. No key needed.
# MCP = its search server (empty = don't use it); HOSTS = where Ultron may download .glb files from.
JARVIS_3DASSETS_MCP=https://3dassets.dev/mcp
JARVIS_3DASSETS_HOSTS=3dassets.dev

# How hard Claude thinks before answering: low | medium | high | xhigh | max.
# Higher = better on hard tasks but uses much more of the Pro usage limit.
JARVIS_EFFORT=medium

# claude.ai connectors to load: "all", or only some, e.g. "Gmail" or "Gmail, Canva".
# Every loaded connector adds its tool list (~9,000 tokens for all 8) to new conversations.
JARVIS_CONNECTORS=all

# Voice mode: the speech-to-text model (faster-whisper, runs on this computer). It downloads
# once, the first time you turn voice mode on. small.en (~250 MB) is fast and English only;
# "small" or "large-v3-turbo" (~1.6 GB, slower) also hear other languages.
JARVIS_STT_MODEL=small.en
# Groq API key (free: console.groq.com -> API Keys). With it, your speech is turned into text
# by Groq's Whisper large-v3-turbo: more accurate and faster, but the audio goes to Groq.
# Without it (or if Groq fails), the local model above is used.
GROQ_API_KEY=
# Windows only: while no Ultron window is open, listen for "Hey Ultron" on the default mic and
# open Ultron full screen (in Edge), already listening. "off" turns it off.
JARVIS_BACKGROUND_WAKE=on

# Ultron's voice when it answers what you said in voice mode: a Kokoro voice (runs on this
# computer; ~350 MB, downloads the first time). b = British, a = American; m = man, f = woman,
# e.g. bm_lewis (low, steady), bm_george, am_onyx (deepest), af_heart, bf_emma.
JARVIS_VOICE=bm_lewis

# Minutes without a message after which a big conversation starts over fresh.
# Claude's cached copy expires after an hour, so continuing would re-send it all
# at full price. 0 = never start over by itself (the "New chat" button still works).
JARVIS_NEW_CHAT_AFTER_IDLE_MIN=60

# Scheduled jobs. Watchers ("tell me when X replies") pause during quiet hours; jobs
# set for a time of day (a 06:30 briefing) still run. Empty = no quiet hours.
JARVIS_QUIET_HOURS=23:00-07:00
# Jobs are skipped once this much (0-1) of the Pro 5-hour limit is used.
JARVIS_JOBS_MAX_USAGE=0.8

# Which brain Ultron starts on: claude (your Pro login, the default) or omniroute.
# You can also switch in the app (gear icon, top right). Switching starts a new chat.
JARVIS_PROVIDER=claude
# OmniRoute (npm i -g omniroute, then run: omniroute) is a gateway to other providers'
# models. It doesn't use your Pro limit. In that mode the claude.ai connectors (Gmail,
# ...) and web search stay off, and other models may use Ultron's tools less reliably.
JARVIS_GATEWAY_URL=http://localhost:20128
# The gateway's API key, if you set one in OmniRoute.
JARVIS_GATEWAY_KEY=
# The OmniRoute models you can switch between in the app (the model buttons), as
# OmniRoute names them: provider/model. The first one is the default. Each needs its
# provider connected in OmniRoute's dashboard (http://localhost:20128 -> Providers).
JARVIS_GATEWAY_MODELS=gemini/gemini-3.1-flash-lite, gemini/gemini-3.8-flash, groq/openai/gpt-oss-120b

# Backend address. Must stay on 127.0.0.1 (this machine only).
JARVIS_HOST=127.0.0.1
JARVIS_PORT=8000

# Ultron on your phone (optional), through Tailscale: a private network of your own devices.
#   1. Install Tailscale on this Mac and on your phone, signed in to the same account.
#   2. On this Mac: tailscale serve --bg 8000   (use your JARVIS_PORT)
#      It prints this Mac's address (https://….ts.net). Paste it here and restart Ultron.
#   3. Open that address on your phone.
# Never use "tailscale funnel": that puts Ultron on the public internet, with no password.
JARVIS_REMOTE_ORIGIN=

# Your Windows PC (optional), through Tailscale. Set it up with windows/SETUP_PROMPT.md (or run
# windows/install.ps1 there), then paste the two lines it prints: the PC's Tailscale address and
# the token from windows/token.txt. Empty = no PC tools.
JARVIS_PC_URL=
JARVIS_PC_TOKEN=
