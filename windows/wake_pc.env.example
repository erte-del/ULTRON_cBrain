# Settings for wake_pc.py ("Hey Ultron" on this PC opens the Mac's Ultron).
# Copy to wake_pc.env (git-ignored) and fill in.

# The Mac's Ultron over Tailscale ("tailscale status" lists the Mac).
ULTRON_URL=https://your-mac.your-tailnet.ts.net

# Optional: your own script or shortcut that opens it (.ps1, .bat, .cmd, .py, .lnk, .url).
# When set, it's used instead of the Edge window.
# ULTRON_OPEN=C:\Users\you\Desktop\Ultron.lnk

# Optional: the speech model (default small.en; base.en is faster but less accurate).
# WAKE_MODEL=small.en
